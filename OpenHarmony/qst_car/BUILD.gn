static_library("qst_car") {
    motion_replay_only = true

    if (motion_replay_only) {
        sources = [
            "qst_car_main.c",
            "src/motion_replay.c",
            "src/Peripheral.c",
            "src/robot_l9110s.c",
        ]
    } else {
    sources = [
        "qst_car_main.c",
        "src/task_hello.c",
        "src/motion_replay.c",
        "src/task_wifi.c",
        "src/wifi_connect.c",

        "src/Peripheral.c",
        "src/robot_hcsr04.c",
        "src/robot_l9110s.c",
        "src/robot_sg90.c",
        "src/task10_servo_distance.c",
        "src/task_hcsr04.c",
        "src/task10_bluetooth.c",
        "src/task10_trace.c",
        "src/task_ir.c",
        "src/task_oled.c",
        "src/task_sht20.c",
        "src/task_ap3216.c",
        "src/task_sensor.c",
        "src/line_sensor.c",
        "src/task_car_control.c",
        "src/udp_telemetry.c",
        "src/task_cloud.c",
        "src/oc_mqtt.c",
        "src/oc_mqtt_profile_package.c",
        "src/hal_bsp_ssd1306.c",
        "src/hal_bsp_sht20.c",
        "src/hal_bsp_ap3216c.c",
        "src/trace_model.c",
        "src/uart_task9.c",
        "src/task_encoder_cal.c",
        "src/task_encoder_arc_roundtrip.c",
        "src/task_encoder_right_arc_roundtrip.c",
        "src/task_encoder_two_arc_roundtrip.c",
        "src/task_encoder_segment_b_progress.c",
        "src/task_encoder_bpath_follow.c",
        "src/task_motor_response.c",
    ]
    }

    include_dirs = [
        "include",

        "//utils/native/lite/include",

        # CMSIS RTOS2
        "//kernel/liteos_m/components/cmsis/2.0",

        # WifiIot APIs, including UartRead/UartWrite declarations
        "//base/iot_hardware/interfaces/kits/wifiiot_lite",
        "//foundation/communication/interfaces/kits/wifi_lite/wifiservice",
        "//vendor/hisi/hi3861/hi3861/third_party/lwip_sack/include",

        # MQTT
        "//third_party/paho_mqtt/MQTTPacket/src",
        "//third_party/paho_mqtt/MQTTClient-C/src",
        "//third_party/paho_mqtt/MQTTClient-C/src/liteOS",
        "//third_party/cJSON",
    ]

    deps = [
        "//third_party/paho_mqtt:pahomqtt_static",
        "//third_party/cJSON:cjson_static",
    ]
}
